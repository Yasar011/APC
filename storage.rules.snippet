// SNIPPET — do not deploy on its own if Storage is already in use.
//
// Storage rules, like database rules, are one file for the whole bucket. If
// APC already has rules here for other features (movie night screenshots,
// say), paste the `match /jawaiTrip/...` block and the isJawaiAdmin()
// function INSIDE the existing `match /b/{bucket}/o { ... }` block,
// alongside what is already there.
//
// If nothing uses Firebase Storage in this project yet, publish this whole
// file as-is: Firebase Console -> Storage -> Rules -> paste -> Publish.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Payment screenshots. A student writes only into their own folder, and
    // only they and trip admins can read them back — a UPI screenshot shows
    // a name and often a bank balance, so it is never world-readable.
    match /jawaiTrip/payments/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isJawaiAdmin());

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Storage rules cannot read the Realtime Database, so the `roles` node
    // that grants admin everywhere else in this app is invisible here and
    // trip admins have to be listed by hand.
    //
    // This is the ONE place admins are duplicated. Anyone who needs to open
    // a payment screenshot must be in this list AND be roles/<uid> ==
    // 'admin' in the database. Staff are deliberately absent: they scan
    // people onto the bus and have no business seeing payments.
    function isJawaiAdmin() {
      return request.auth.uid in [
        'kGmSLYoXlUgrdAfKogkfzmPWrrL2'
        // add further admin uids here, comma separated
      ];
    }
  }
}
