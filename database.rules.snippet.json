{
  "___README___": [
    "THIS IS A SNIPPET, NOT A COMPLETE RULES FILE. DO NOT DEPLOY IT ON ITS OWN.",
    "",
    "Realtime Database rules are one JSON tree for the entire database.",
    "Publishing a file that contains only these rules would DELETE the rules",
    "protecting APC's movie night data (roles, settings, promoCodes,",
    "movieSeats, bookings).",
    "",
    "To install: Firebase console -> Realtime Database -> Rules, and paste the",
    "'jawaiTrip' block below INSIDE the existing top-level 'rules' object, as a",
    "sibling of the keys already there. Then Publish.",
    "",
    "Delete this ___README___ key when you paste - it is documentation only.",
    "database.rules.MERGED-EXAMPLE.json is the finished result to compare with.",
    "",
    "ADMINS: this app reuses APC's existing top-level `roles` node rather than",
    "keeping its own list. Anyone already roles/<uid> == 'admin' (or the",
    "founding uid hardcoded in the rules) is a trip admin with nothing to set",
    "up. roles/<uid> == 'staff' can scan people onto the bus and nothing else -",
    "no payments, no roster, no margin.",
    "",
    "ONE SEAT PER NIFT ID: seats is validated to exactly 1, and niftIdIndex",
    "makes the ID itself the lock. An unclaimed key can be written by any",
    "signed-in user, a claimed one only by an admin - so two people submitting",
    "the same ID at the same moment cannot both get a seat. To free an ID (a",
    "cancellation, a typo), delete its key under jawaiTrip/niftIdIndex.",
    "",
    "No .indexOn entries are needed: every read here is a direct key lookup",
    "or a whole-node read by an admin, never an orderByChild query.",
    "",
    "PAYMENT SCREENSHOTS: shrunk in the browser and stored under",
    "jawaiTrip/paymentShots/<bookingId>, not on the booking, so the admin list",
    "can load every booking without dragging every image down with it. There is",
    "no Firebase Storage bucket and no second rules file to set up."
  ],
  "jawaiTrip": {
    "settings": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')"
    },
    "finance": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')"
    },
    "bookings": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$bookingId": {
        ".read": "auth != null && (data.child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && ((!data.exists() && newData.child('bookerUid').val() === auth.uid) || (data.exists() && data.child('bookerUid').val() === auth.uid && data.child('status').val() !== 'CONFIRMED') || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".validate": "newData.hasChildren(['bookerUid', 'niftId', 'seats', 'status', 'travellers', 'pricing', 'bookingCode', 'createdAt'])",
        "bookerUid": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "seats": {
          ".validate": "newData.isNumber() && newData.val() === 1"
        },
        "niftId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (!data.exists() || newData.val() === data.val())"
        },
        "status": {
          ".validate": "newData.isString() && (((newData.val() === 'AWAITING_PAYMENT' || newData.val() === 'PENDING_VERIFICATION') && (newData.parent().child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))) || ((newData.val() === 'CONFIRMED' || newData.val() === 'REJECTED' || newData.val() === 'CANCELLED') && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')))"
        },
        "verifiedBy": {
          ".validate": "!newData.exists() || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "bookingsByUser": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && (auth.uid === $uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))"
      }
    },
    "bookingCodeIndex": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff')",
      "$bookingCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".validate": "newData.isString()"
      }
    },
    "niftIdIndex": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$niftId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".validate": "newData.isString()"
      }
    },
    "paymentShots": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$bookingId": {
        ".read": "auth != null && (root.child('jawaiTrip/bookings').child($bookingId).child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".write": "auth != null && (root.child('jawaiTrip/bookings').child($bookingId).child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin'))",
        ".validate": "newData.isString() && newData.val().length <= 900000"
      }
    },
    "tickets": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff')",
      ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$ticketCode": {
        ".read": "auth != null && (data.child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff'))",
        "boarded": {
          ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff')",
          ".validate": "newData.isBoolean()"
        },
        "boardedAt": {
          ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff')",
          ".validate": "newData.isNumber()"
        },
        "boardedBy": {
          ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff')",
          ".validate": "newData.isString()"
        }
      }
    },
    "ticketsByBooking": {
      ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$bookingId": {
        ".read": "auth != null && (root.child('jawaiTrip/bookings').child($bookingId).child('bookerUid').val() === auth.uid || (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'staff'))"
      }
    },
    "promoCodes": {
      ".read": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      ".write": "auth != null && (auth.uid === 'kGmSLYoXlUgrdAfKogkfzmPWrrL2' || root.child('roles').child(auth.uid).val() === 'admin')",
      "$code": {
        ".read": "auth != null"
      }
    }
  }
}
