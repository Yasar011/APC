# Firebase — you do NOT need this file to run the app.
#
# APC's Firebase config (project `apc-movie`) is committed in
# src/lib/firebase.ts, so `npm run dev` works straight after a clone.
# Set these only to point at a different Firebase project.

# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=


# Cloudinary — where payment screenshots go.
#
# Set all three and screenshots upload to Cloudinary, the same way the TEDx
# app does. Leave them blank and screenshots fall back to being shrunk and
# stored in the Realtime Database, which works with no setup at all.
#
# Find them at cloudinary.com -> Dashboard -> Product Environment Credentials.
# The cloud name is public (it ends up in image URLs). The key and secret are
# NOT - they stay server-side, which is why they have no NEXT_PUBLIC_ prefix.
# On Vercel, add all three under Project -> Settings -> Environment Variables.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
