# You do NOT need this file to run the app.
#
# APC's Firebase config (project `apc-movie`) is committed in
# src/lib/firebase.ts, so `npm run dev` works straight after a clone and
# Vercel needs no environment variables set.
#
# A Firebase web config is not a secret - it is compiled into the JavaScript
# every visitor downloads. The database and storage rules are what protect
# the data.
#
# Copy this to .env.local ONLY if you want to point the app at a different
# Firebase project (a throwaway one for testing, say). Anything set here
# overrides the committed defaults.

# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
