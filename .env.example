# Firebase — you do NOT need this file to run the app.
#
# APC's Firebase config (project `apc-movie`) is committed in
# src/lib/firebase.ts, so `npm run dev` works straight after a clone.
# Set these only to point at a different Firebase project.

# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=


# Cloudinary — where payment screenshots go.
#
# Set all three and screenshots upload to Cloudinary, the same way the TEDx
# app does. Leave them blank and screenshots fall back to being shrunk and
# stored in the Realtime Database, which works with no setup at all.
#
# Find them at cloudinary.com -> Dashboard -> Product Environment Credentials.
# The cloud name is public (it ends up in image URLs). The key and secret are
# NOT - they stay server-side, which is why they have no NEXT_PUBLIC_ prefix.
# On Vercel, add all three under Project -> Settings -> Environment Variables.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Google Sheet + confirmation email  (the recommended way)
#
# An Apps Script deployed on the trip spreadsheet does both: it writes each
# confirmed booking into the sheet AND emails the student, sending as the
# Google account that owns the script. No mail password exists anywhere.
#
# Setup is in apps-script/Code.gs - paste it into the sheet's Apps Script
# editor, deploy it as a Web App, and put the /exec URL and your chosen
# secret here. The secret is what keeps strangers out of the endpoint, so
# make it long and random, and keep it identical in both places.

SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=


# Gmail SMTP  (fallback, only if you skip the Apps Script above)
#
# Sends the same email, but nothing goes into the sheet. GMAIL_APP_PASSWORD
# is NOT the Gmail password: turn on 2-Step Verification, then create one at
# myaccount.google.com/apppasswords.
#
# Leave every one of these blank and confirming still works - the admin just
# sends the message on WhatsApp from the booking page instead.

GMAIL_USER=
GMAIL_APP_PASSWORD=
